{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"scripts": {
		"db": "pnpm drizzle-kit generate --config \"drizzle.config.ts\"",
		"build": "concurrently \"bun run build:lint\" \"bun run build:tsc\" && bun run build:nuxt",
		"build:lint": "eslint . --cache",
		"lint:timing": "TIMING=1 eslint .",
		"lint": "TIMING=1 eslint .",
		"build:tsc": "nuxi typecheck",
		"build:nuxt": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxi build",
		"dev": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxi dev",
		"prepare": "husky install",
		"postinstall": "nuxt prepare",
		"run-prettier": "npx prettier --write **/*.{js,ts,json,tsx,vue,cjs,mjs}",
		"hooks:commitlint": "commitlint --edit",
		"hooks:pre-commit": "npx prettier --write **/*.{js,ts,json,tsx,vue,cjs,mjs} && git add ."
	},
	"dependencies": {
		"@kmods/drizzle-pg": "1.9.0",
		"@nuxt/icon": "^1.0.0",
		"@nuxt/kit": "^3.12.3",
		"@primevue/themes": "4.0.0",
		"@sidebase/nuxt-auth": "^0.7.2",
		"@tailwindcss/typography": "^0.5.13",
		"@vueuse/components": "^10.11.0",
		"@vueuse/nuxt": "^10.11.0",
		"axios": "^1.7.2",
		"compressing": "^1.10.1",
		"dotenv": "^16.4.5",
		"drizzle-kit": "^0.22.8",
		"lodash": "^4.17.21",
		"moment": "^2.30.1",
		"moment-timezone": "^0.5.45",
		"next-auth": "4.22.3",
		"node-cron": "^3.0.3",
		"nuxt": "^3.12.3",
		"pinia": "^2.1.7",
		"postgres": "^3.4.4",
		"primeicons": "^7.0.0",
		"primevue": "4.0.0",
		"semver": "^7.6.2",
		"typescript-eslint": "^7.15.0",
		"update7-bp": "npm:@etothepii/satisfactory-file-parser@^0.0.34",
		"update8-bp": "npm:@etothepii/satisfactory-file-parser@^0.1.30",
		"uuid": "^10.0.0",
		"vue": "^3.4.31",
		"vue-final-modal": "^4.5.4",
		"vue-router": "^4.4.0",
		"vue3-emoji-picker": "^1.1.8",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@modyfi/vite-plugin-yaml": "^1.1.0",
		"@nuxt/devtools": "^1.3.9",
		"@nuxt/image": "^1.7.0",
		"@nuxt/types": "^2.18.1",
		"@nuxtjs/color-mode": "^3.4.2",
		"@nuxtjs/eslint-config-typescript": "^12.1.0",
		"@nuxtjs/eslint-module": "^4.1.0",
		"@nuxtjs/tailwindcss": "^6.12.0",
		"@pinia-plugin-persistedstate/nuxt": "^1.2.1",
		"@pinia/nuxt": "^0.5.1",
		"@primevue/nuxt-module": "4.0.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^12.0.0",
		"@semantic-release/exec": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^10.0.7",
		"@semantic-release/release-notes-generator": "^13.0.0",
		"@types/formidable": "^3.4.5",
		"@types/lodash": "^4.17.6",
		"@types/node-cron": "^3.0.11",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^7.15.0",
		"@typescript-eslint/parser": "^7.15.0",
		"concurrently": "^8.2.2",
		"eslint": "^9.6.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-unused-imports": "^4.0.0",
		"formidable": "^3.5.1",
		"glob": "^10.4.2",
		"husky": "^9.0.11",
		"jsonc-eslint-parser": "^2.4.0",
		"moment-duration-format": "^2.3.2",
		"nitropack": "^2.9.7",
		"prettier": "^3.3.2",
		"prettier-plugin-organize-imports": "^4.0.0",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"sass": "^1.77.6",
		"semantic-release": "^23.0.8",
		"sharp": "0.32.6",
		"tailwindcss": "^3.4.4",
		"typescript": "^5.5.3",
		"yaml-eslint-parser": "^1.2.3"
	},
	"version": "1.0.0"
}
